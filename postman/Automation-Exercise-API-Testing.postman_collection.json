    {
      "name": "AE-API-011 - Create Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Use collection-owned values; never overwrite a shared login environment.",
              "const email = \"reuben.qa.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\";",
              "const password = pm.variables.replaceIn(\"{{$guid}}\");",
              "pm.collectionVariables.set(\"newUserEmail\", email);",
              "pm.collectionVariables.set(\"newUserPassword\", password);",
              "pm.collectionVariables.unset(\"createdUserEmail\");",
              "pm.variables.set(\"newUserEmail\", email);",
              "pm.variables.set(\"newUserPassword\", password);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"HTTP status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response body is valid JSON\", function () {",
              "    pm.expect(response).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"JSON responseCode is 201\", function () {",
              "    pm.expect(response.responseCode).to.eql(201);",
              "});",
              "",
              "pm.test(\"Account creation message is correct\", function () {",
              "    pm.expect(response.message).to.eql(\"User created!\");",
              "});",
              "if (pm.response.code === 200 && response.responseCode === 201) {",
              "    pm.collectionVariables.set(\"createdUserEmail\", pm.collectionVariables.get(\"newUserEmail\"));",
              "}"
            ]
          }
        }
      ],
