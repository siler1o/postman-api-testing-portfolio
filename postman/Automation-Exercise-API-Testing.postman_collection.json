        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.collectionVariables.get(\"newUserEmail\");",
              "const password = pm.collectionVariables.get(\"newUserPassword\");",
              "const owned = email && password && pm.collectionVariables.get(\"createdUserEmail\") === email;",
              "pm.test(\"Account was created by AE-API-011\", () => pm.expect(Boolean(owned)).to.eql(true));",
              "if (!owned) { pm.execution.skipRequest(); }",
