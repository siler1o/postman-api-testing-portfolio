    {
      "name": "AE-API-005 - Search Product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "const searchTerm = pm.variables.replaceIn(pm.request.body.formdata.get(\"search_product\")).trim().toLowerCase();",
              "pm.test(\"HTTP status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON responseCode is 200\", () => pm.expect(response.responseCode).to.eql(200));",
              "pm.test(\"Search returns products\", function () {",
              "    pm.expect(response.products).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.test(\"Each product matches the keyword in name, brand, or category\", function () {",
              "    pm.expect(searchTerm).not.to.eql(\"\");",
              "    pm.expect(response.products).to.be.an(\"array\").that.is.not.empty;",
              "    response.products.forEach(product => {",
              "        const fields = [product.name, product.brand, product.category && product.category.category];",
              "        pm.expect(fields.some(value => typeof value === \"string\" && value.toLowerCase().includes(searchTerm)),",
              "            \"Unrelated product: \" + product.name).to.eql(true);",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "search_product",
              "value": "{{searchProduct}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/searchProduct",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "searchProduct"
          ]
        }
      },
      "response": []
    },
