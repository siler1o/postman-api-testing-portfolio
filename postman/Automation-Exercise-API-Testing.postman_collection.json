    {
      "name": "AE-API-012 – Delete Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const email = pm.collectionVariables.get(\"newUserEmail\");",
              "const password = pm.collectionVariables.get(\"newUserPassword\");",
              "const owned = email && password && pm.collectionVariables.get(\"createdUserEmail\") === email;",
              "pm.test(\"Account was created by AE-API-011\", () => pm.expect(Boolean(owned)).to.eql(true));",
              "if (!owned) { pm.execution.skipRequest(); }",
              "pm.variables.set(\"newUserEmail\", email);",
              "pm.variables.set(\"newUserPassword\", password);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"HTTP status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response body is valid JSON\", function () {",
              "    pm.expect(response).to.be.an(\"object\");",
              "});",
              "",
              "pm.test(\"JSON responseCode is 200\", function () {",
              "    pm.expect(response.responseCode).to.eql(200);",
              "});",
              "",
              "pm.test(\"Account deletion message is correct\", function () {",
              "    pm.expect(response.message).to.eql(\"Account deleted!\");",
              "});",
              "if (pm.response.code === 200 && response.responseCode === 200) {",
              "    const email = pm.collectionVariables.get(\"newUserEmail\");",
              "    const password = pm.collectionVariables.get(\"newUserPassword\");",
              "    pm.sendRequest({",
              "        url: pm.variables.replaceIn(\"{{baseUrl}}\") + \"/api/verifyLogin\",",
              "        method: \"POST\",",
              "        body: { mode: \"urlencoded\", urlencoded: [",
              "            { key: \"email\", value: email }, { key: \"password\", value: password }",
              "        ]}",
              "    }, function (error, result) {",
              "        pm.test(\"Deleted account can no longer log in\", function () {",
              "            pm.expect(error).to.equal(null);",
              "            pm.expect(result.code).to.eql(200);",
              "            const body = result.json();",
              "            pm.expect(body.responseCode).to.eql(404);",
              "            pm.expect(body.message).to.eql(\"User not found!\");",
              "        });",
              "    });",
              "    [\"createdUserEmail\", \"newUserEmail\", \"newUserPassword\"].forEach(key => {",
              "        pm.collectionVariables.unset(key);",
              "        pm.variables.unset(key);",
              "    });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
