      "name": "AE-API-001 - Get All Products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();",
              "",
              "pm.test(\"HTTP status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"JSON responseCode is 200\", function () {",
              "    pm.expect(response.responseCode).to.eql(200);",
              "});",
              "",
              "pm.test(\"Products list is not empty\", function () {",
              "    pm.expect(response.products).to.be.an(\"array\");",
              "    pm.expect(response.products.length).to.be.above(0);",
              "});",
              "",
              "const limit = Number(pm.variables.get(\"maxResponseTimeMs\"));",
              "if (limit > 0) {",
              "    pm.test(\"Response time meets configured threshold\", function () {",
              "        pm.expect(pm.response.responseTime).to.be.below(limit);",
              "    });",
              "}"
            ]
          }
        }
      ],
